---
import Base from "../../layouts/Base.astro";
import Status from "../../components/Status.astro";
import { models } from "../../data/models";
import { fmtInt, fmtParams, modelStatus } from "../../lib/models";
---

<Base title="Models" description="Future Aulvero model releases and model cards." active="models">
  <div class="wrap page">
    <header class="page-head">
      <h1>Models</h1>
      <p>Our future models will live here.</p>
    </header>
    {models.length === 0 && <section class="empty-state"><div class="empty-symbol" aria-hidden="true"><i></i><i></i><i></i><i></i></div><p class="eyebrow">Still taking shape</p><h2>Good things take research.</h2><p>We have no models to announce yet. We’re working toward highly capable small models with a lower memory footprint.</p><a class="btn" href="/updates/">Follow our progress</a></section>}
    {models.map((model) => (
      <article class="model-card">
        <div class="card-heading">
          <h2><a href={`/models/${model.id}/`}>{model.name} <span class="muted">{fmtParams(model.params)}</span></a></h2>
          <Status status={modelStatus(model)} />
        </div>
        <p>{model.summary}</p>
        <dl class="quick-specs">
          <div><dt>Context</dt><dd>{fmtInt(model.context)} tokens</dd></div>
          <div><dt>Variants</dt><dd>Base & Instruct</dd></div>
          <div><dt>License</dt><dd>{model.license === "TBA" ? "To be announced" : model.license}</dd></div>
        </dl>
        <a href={`/models/${model.id}/`}>View specifications and release status</a>
      </article>
    ))}
    <p class="note">See the <a href="/comparison/">comparison</a> for an overview of specifications and evaluation status.</p>
  </div>
</Base>
