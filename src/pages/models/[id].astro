---
import Base from "../../layouts/Base.astro";
import Status from "../../components/Status.astro";
import { architecture, models, type Model } from "../../data/models";
import { coreVariants, exactParams, fmtInt, fmtParams, fmtTokens, latest, repoId } from "../../lib/models";

export function getStaticPaths() {
  return models.map((model) => ({ params: { id: model.id }, props: { model } }));
}
interface Props { model: Model }
const { model } = Astro.props;
const version = latest(model);
const specs = [
  ["Architecture", architecture.type],
  ["Parameters (estimated)", `${(exactParams(model) / 1e6).toFixed(1)}M`],
  ["Focus", "General purpose"],
  ["Context", `${fmtInt(model.context)} tokens`],
  ["Layers / hidden size", `${model.config.layers} / ${fmtInt(model.config.hidden)}`],
  ["Attention heads", `${model.config.heads} query / ${model.config.kvHeads} key-value`],
  ["Vocabulary", `${fmtInt(architecture.vocab)} tokens`],
  ["Training budget (planned)", `${fmtTokens(model.trainingTokens)} tokens`],
  ["License", model.license === "TBA" ? "To be announced" : model.license],
];
---

<Base title={`${model.name} ${fmtParams(model.params)}`} description={model.summary} active="models">
  <div class="wrap page">
    <header class="page-head">
      <a class="breadcrumb" href="/models/">Models</a>
      <h1>{model.name} <span class="muted">{fmtParams(model.params)}</span></h1>
      <p>{model.summary}</p>
    </header>
    <section aria-labelledby="specs-title">
      <h2 id="specs-title">Specifications</h2>
      <dl class="specs">{specs.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
      <p class="note">Configuration for {version.version}. Final specifications will be confirmed at release. <a href="/docs/architecture/">Architecture details</a>.</p>
    </section>
    <section class="text-section" aria-labelledby="variants-title">
      <h2 id="variants-title">Variants</h2>
      <div class="variant-grid">
        {coreVariants.map((variant) => {
          const status = version.variants[variant.id] ?? "planned";
          return <article class="variant-card">
            <div class="card-heading"><h3>{variant.name}</h3><Status status={status} /></div>
            <p>{variant.description}</p>
            {status === "released"
              ? <a href={`https://huggingface.co/${repoId(model, variant.id, version.version)}`}>Download on Hugging Face</a>
              : <p class="note">Weights are not available yet.</p>}
          </article>;
        })}
      </div>
    </section>
    <div class="actions"><a href="/docs/training/">Training guide</a><a href="/comparison/">Comparison</a></div>
  </div>
</Base>
