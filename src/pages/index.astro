---
import Base from "../layouts/Base.astro";
import MemoryStudy from "../components/MemoryStudy.astro";
import SocialLinks from "../components/SocialLinks.astro";
import UpdateCard from "../components/UpdateCard.astro";
import { getUpdates } from "../lib/updates";
const updates = (await getUpdates()).slice(0, 2);
---

<Base>
  <div class="home-shell">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Aulvero / a GitHub organization</p>
        <h1 id="hero-title">Make every<br /><span>parameter</span><br />count.</h1>
        <p class="hero-description">Big ambitions for small language models. We’re working toward more capability with fewer parameters and less memory.</p>
        <div class="hero-actions"><a class="btn" href="/docs/">Inside the project</a><a class="text-link" href="#approach">What we’re exploring</a></div>
        <div class="hero-community"><span>Find the work</span><SocialLinks /></div>
      </div>
      <MemoryStudy />
    </section>

    <section class="approach-section" id="approach" aria-labelledby="approach-title">
      <div class="approach-heading"><p class="eyebrow">What we’re exploring</p><h2 id="approach-title">A small-model<br /><span>state of mind.</span></h2><p>Aulvero is a GitHub organization exploring how to make small, general-purpose language models more capable and less demanding on memory.</p><a class="text-link" href="/updates/our-focus/">Read about our direction</a></div>
      <div class="principles">
        <article><span class="principle-icon icon-capability" aria-hidden="true"></span><div><h3>Capability comes first.</h3><p>Small is only meaningful when it’s useful. We’re aiming for strong general-purpose models that can do real work.</p></div></article>
        <article><span class="principle-icon icon-memory" aria-hidden="true"></span><div><h3>Every byte matters.</h3><p>Memory is a design constraint from the start. Our goal is to make capable models practical on more hardware.</p></div></article>
        <article><span class="principle-icon icon-evaluation" aria-hidden="true"></span><div><h3>Show the whole picture.</h3><p>Quality, memory, and the conditions behind a result. That’s how we want to measure and share our progress.</p></div></article>
      </div>
    </section>

    <section class="home-updates" aria-labelledby="updates-title">
      <div class="section-heading"><div><p class="eyebrow">Updates & ideas</p><h2 id="updates-title">The project notebook.</h2></div><a class="text-link" href="/updates/">All updates</a></div>
      <div class="updates-grid">{updates.map((update) => <UpdateCard update={update} />)}</div>
    </section>

    <section class="closing-section"><div><p class="eyebrow">Follow along</p><h2>Still early.<br />Plenty to explore.</h2></div><div><p>No models to announce yet. The code, notes, and future releases will grow from here.</p><SocialLinks /><a class="text-link" href="/updates/">Read the latest notes</a></div></section>
  </div>
</Base>
